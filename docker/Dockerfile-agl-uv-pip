FROM verlai/verl:vllm011.latest

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1
ENV UV_LINK_MODE=copy
ENV UV_FROZEN=1
WORKDIR /workspace

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 1. 基础工具安装与 Node.js 配置
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server net-tools vim telnet iputils-ping \
        unzip bzip2 tmux curl git && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    mkdir -p /var/run/sshd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/*

# 2. 合并：源码下载、多组依赖安装、编译、Dashboard 构建、清理
# 将原本分散的 RUN 合并为一个，确保空间在层提交前释放
RUN git clone --depth 1 https://github.com/microsoft/agent-lightning.git /workspace/agent-lightning && \
    cd /workspace/agent-lightning && \
    # 安装 pyproject.toml 中的所有指定 group 依赖
    uv pip install -r pyproject.toml --system \
        --group dev \
        --group experiment \
        --group image \
        --group core-stable \
        --group langchain \
        --group torch-gpu-stable \
        --group trl \
        --group agents && \
    # 切换为 PyPI 正式版本及其他包
    uv pip uninstall --system -y agentlightning && \
    uv pip install --system agentlightning pymongo swanlab vllm==0.11.2 && \
    # 强制重新安装 flash_attn (由于编译较重，建议放在清理前的最后一步)
    pip install flash_attn==2.8.1 --no-build-isolation --force-reinstall && \
    # 构建 Dashboard
    cd dashboard && \
    npm ci --prefer-offline --no-audit --progress=false && \
    npm run build && \
    # 拷贝产物到 site-packages
    cp -r /workspace/agent-lightning/dashboard /usr/local/lib/python3.12/dist-packages/agentlightning && \
    # 导出环境列表到 /workspace
    uv pip freeze --system --exclude-editable > /workspace/requirements.txt && \
    # --- 彻底清理阶段 ---
    cd /workspace && \
    rm -rf /workspace/agent-lightning && \
    rm -rf /root/.cache/uv \
           /root/.cache/npm \
           /root/.cache/pip \
           /root/.npm \
           /tmp/* \
           /var/tmp/* && \
    find /usr/local/lib/python3.12 -name "*.pyc" -delete 2>/dev/null || true

# 保持 aladdin 镜像需求
EXPOSE 8080